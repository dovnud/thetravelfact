---
import Base from "../layouts/Base.astro";
import { destinations, hubs } from "../lib/destinations";
import SearchForm from "../components/SearchForm.astro";
import { photos } from "../data/photos";

const countries = destinations.filter((d) => d.kind === "country");
// Cities whose country has no sheet of its own (for example the United States) get an unlinked group heading.
const orphanGroups = [...new Set(destinations.filter((d) => d.kind === "city" && !countries.some((c) => c.countrySlug === d.countrySlug)).map((d) => d.countrySlug))]
  .map((slug) => destinations.filter((d) => d.kind === "city" && d.countrySlug === slug));
const groups = [
  ...countries.map((country) => ({ head: country, rows: [country, ...destinations.filter((d) => d.kind === "city" && d.countrySlug === country.countrySlug)] })),
  ...orphanGroups.map((rows) => ({ head: null, name: rows[0].countryName, hub: hubs.find((h) => h.countrySlug === rows[0].countrySlug), rows })),
].sort((a, b) => a.rows[0].order - b.rows[0].order);
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      name: "TheTravelFact",
      url: "https://thetravelfact.com/",
      description: "Sourced destination sheets: climate, plugs, driving, tipping, water, currency, and time zone.",
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [{ "@type": "ListItem", position: 1, name: "Home", item: "https://thetravelfact.com/" }],
    },
  ],
};
---

<Base
  title="TheTravelFact"
  description="Sourced destination sheets for Mexico, Canada, the United Kingdom, Italy, France, the Dominican Republic, Spain, Germany, Japan, Ireland, Portugal, the Netherlands, Greece, Iceland, Switzerland, Austria, Czechia, Croatia, Hungary, Poland, Turkey, Morocco, Egypt, Costa Rica, Jamaica, the Bahamas, Aruba, Panama, Colombia, Peru, Brazil, Argentina, Chile, Thailand, South Korea, Vietnam, Indonesia, Singapore, Australia, New Zealand, India, South Africa, Dubai, New York, Miami, Los Angeles, San Francisco, Hawaii, and Puerto Rico. Every climate number has a station, a source, and a date."
  jsonLd={jsonLd}
>
  <figure class="photo">
    <img
      src="/photos/home.jpg"
      srcset="/photos/home-800.jpg 800w, /photos/home.jpg 1600w"
      sizes="100vw"
      alt="Departures board at Melbourne Airport"
      width="1600"
      height="1067"
      fetchpriority="high"
    />
    <figcaption>
      <span>Departures board at Melbourne Airport</span>
      <span>
        Photograph: Marek Ślusarczyk (Tupungato), <a href="https://creativecommons.org/licenses/by/3.0">CC BY 3.0</a>, via <a href="https://commons.wikimedia.org/wiki/File:47_Airport_departures_board_free_photo_-_Melbourne_Airport_timetable_-_Creative_Commons_Attribution.jpg">Wikimedia Commons</a>
      </span>
    </figcaption>
  </figure>
  <section class="hero-search shell">
    <h2 class="hero-search-title">Find a sheet</h2>
    <SearchForm id="q-hero" size="large" />
  </section>
  <section class="deck">
    <div class="deck-kicker">102 sheets</div>
    <p>
      A destination sheet is one URL. It holds the month-by-month climate of a named station, then the plug, the side of the road, tipping, tap water, the currency, and the time zone. If a number has no source, it is not on the page.
      The order below is the launch list. <a href="#index">The index</a> starts with Mexico. <a href="/sources/">The method</a> is written out.
    </p>
  </section>

  <section class="shell" id="index" style="padding: 1.4rem 0 3rem;">
    <h1 style="font-size: clamp(2.6rem, 1.4rem + 3vw, 4rem); margin-bottom: 0.8rem;">Index</h1>
    <table class="index">
      <thead>
        <tr>
          <th scope="col">No.</th>
          <th scope="col">Place</th>
          <th scope="col">Photograph</th>
        </tr>
      </thead>
      <tbody>
        {groups.map((group) => {
          const rows = group.rows;
          return (
            <>
              <tr class="group-row">
                <td colspan="3">{group.head ? <a href={group.head.path}>{group.head.name}</a> : group.hub ? <a href={group.hub.path}>{group.name}</a> : group.name}</td>
              </tr>
              {rows.map((place) => (
                <tr>
                  <td class="no">{String(place.order).padStart(2, "0")}</td>
                  <td>
                    <a class="rowlink" href={place.path}>
                      <span>
                        <span class="place">{place.name}</span>
                        <span class="station">{place.climate.stationName}</span>
                      </span>
                    </a>
                  </td>
                  <td>
                    <a href={place.path}>
                      <img src={photos[place.id].src} alt="" width="96" height="64" loading={place.order < 3 ? "eager" : "lazy"} />
                    </a>
                  </td>
                </tr>
              ))}
            </>
          );
        })}
      </tbody>
    </table>
    <p class="note" style="margin-top: 0.8rem;">
      Photographs are credited on each sheet. The country row repeats in the list so the country sheet is a line of its own, not only a heading.
    </p>
  </section>
</Base>
