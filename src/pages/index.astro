---
import Base from "../layouts/Base.astro";
import { destinations } from "../lib/destinations";
import { photos } from "../data/photos";

const countries = destinations.filter((d) => d.kind === "country");
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      name: "TheTravelFact",
      url: "https://thetravelfact.com/",
      description: "Sourced destination sheets: climate, plugs, driving, tipping, water, currency, and time zone.",
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [{ "@type": "ListItem", position: 1, name: "Home", item: "https://thetravelfact.com/" }],
    },
  ],
};
---

<Base
  title="TheTravelFact"
  description="Sourced destination sheets for Mexico, Canada, the United Kingdom, and Italy. Every climate number has a station, a source, and a date."
  jsonLd={jsonLd}
>
  <section class="deck">
    <div class="deck-kicker">20 sheets</div>
    <p>
      A destination sheet is one URL. It holds the month-by-month climate of a named station, then the plug, the side of the road, tipping, tap water, the currency, and the time zone. If a number has no source, it is not on the page.
      The order below is the launch list. <a href="#index">The index</a> starts with Mexico. <a href="/sources/">The method</a> is written out.
    </p>
  </section>

  <section class="shell" id="index" style="padding: 1.4rem 0 3rem;">
    <h1 style="font-size: clamp(2.6rem, 1.4rem + 3vw, 4rem); margin-bottom: 0.8rem;">Index</h1>
    <table class="index">
      <thead>
        <tr>
          <th scope="col">No.</th>
          <th scope="col">Place</th>
          <th scope="col">Photograph</th>
        </tr>
      </thead>
      <tbody>
        {countries.map((country) => {
          const cities = destinations.filter((d) => d.kind === "city" && d.countrySlug === country.countrySlug);
          const rows = [country, ...cities];
          return (
            <>
              <tr class="group-row">
                <td colspan="3"><a href={country.path}>{country.name}</a></td>
              </tr>
              {rows.map((place) => (
                <tr>
                  <td class="no">{String(place.order).padStart(2, "0")}</td>
                  <td>
                    <a class="rowlink" href={place.path}>
                      <span>
                        <span class="place">{place.name}</span>
                        <span class="station">{place.climate.stationName}</span>
                      </span>
                    </a>
                  </td>
                  <td>
                    <a href={place.path}>
                      <img src={photos[place.id].src} alt="" width="96" height="64" loading={place.order < 3 ? "eager" : "lazy"} />
                    </a>
                  </td>
                </tr>
              ))}
            </>
          );
        })}
      </tbody>
    </table>
    <p class="note" style="margin-top: 0.8rem;">
      Photographs are credited on each sheet. The country row repeats in the list so the country sheet is a line of its own, not only a heading.
    </p>
  </section>
</Base>
