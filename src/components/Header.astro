---
import SearchForm from "./SearchForm.astro";
const path = Astro.url.pathname;
const links = [
  { href: "/#index", label: "Index" },
  { href: "/sources/", label: "Method" },
  { href: "/about/", label: "About" },
  { href: "/contact/", label: "Contact" },
];
---

<header class="mast">
  <div class="shell mast-bar">
    <a class="mark" href="/">
      <span class="mark-block">TTF</span>
      <span class="mark-name">The Travel Fact</span>
    </a>
    <div class="mast-search"><SearchForm id="q-header" /></div>
    <nav class="nav nav-desktop" aria-label="Primary">
      {links.map((link) => (
        <a href={link.href} aria-current={path === link.href ? "page" : undefined}>{link.label}</a>
      ))}
    </nav>
    <details class="menu">
      <summary>Menu</summary>
      <div class="menu-panel">
        <nav aria-label="Mobile">
          {links.map((link) => (
            <a href={link.href}>{link.label}</a>
          ))}
        </nav>
      </div>
    </details>
  </div>
</header>
