---
import Base from "../layouts/Base.astro";
import FactsCard from "./FactsCard.astro";
import ClimatePanel from "./ClimatePanel.astro";
import Affiliates from "./Affiliates.astro";
import { citiesIn, countryOf, extreme, hubOf, joinMonths } from "../lib/destinations";
import { factSources, type Destination, type Fact, type SourceRef } from "../lib/types";
import { photos } from "../data/photos";

interface Props {
  destination: Destination;
}
const { destination } = Astro.props;
const MONTHS = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
function longDate(iso: string) {
  const [year, month, day] = iso.split("-");
  return `${Number(day)} ${MONTHS[Number(month) - 1]} ${year}`;
}
const checked = longDate(destination.climate.asOf);
const entryChecked = longDate(destination.entry.asOf ?? destination.climate.asOf);
const photo = photos[destination.id];
const country = destination.kind === "city" ? countryOf(destination) : destination;
const cities = destination.kind === "country" ? citiesIn(destination.countrySlug) : [];
const canonical = new URL(destination.path, "https://thetravelfact.com").href;
const crumbs = [
  { name: "Home", url: "https://thetravelfact.com/" },
  ...(destination.kind === "city" && country
    ? [{ name: country.name, url: new URL(country.path, "https://thetravelfact.com").href }]
    : []),
  ...(destination.kind === "city" && !country && hubOf(destination)
    ? [{ name: destination.countryName, url: new URL(hubOf(destination)!.path, "https://thetravelfact.com").href }]
    : []),
  { name: destination.name, url: canonical },
];

const facts: Fact[] = [
  destination.plugs,
  destination.driving,
  destination.water,
  destination.currency,
  destination.timeZone,
  ...(destination.tipping ? [destination.tipping] : []),
].filter((fact): fact is Fact => fact != null);

const anchorFor: Record<string, string> = {
  "Plugs and voltage": "plugs",
  "Driving side": "driving",
  Tipping: "tipping",
  "Tap water": "water",
  Currency: "money",
  "Time zone": "time",
};
const hasClimate = destination.climate.months.some((m) => m.high != null || m.low != null || m.rain != null);
const jumps = [
  ...(hasClimate ? [{ id: "weather", label: "Weather by month" }] : []),
  ...[
    { id: "plugs", label: "Plugs" },
    { id: "driving", label: "Driving" },
    { id: "tipping", label: "Tipping" },
    { id: "water", label: "Water" },
    { id: "money", label: "Money" },
    { id: "time", label: "Time" },
  ].filter((j) => facts.some((f) => anchorFor[f.label] === j.id)),
  { id: "entry", label: "Entry" },
];
const kicker = destination.sheetLabel ?? (destination.kind === "country" ? "Country sheet" : destination.countryName);

const sources: SourceRef[] = [
  {
    sourceTitle: destination.climate.sourceTitle,
    sourceUrl: destination.climate.sourceUrl,
    asOf: destination.climate.asOf,
  },
  ...facts.flatMap(factSources),
];
if (destination.season.length) {
  sources.push({
    sourceTitle: "National Hurricane Center, tropical cyclone climatology",
    sourceUrl: "https://www.nhc.noaa.gov/climo/",
    asOf: destination.climate.asOf,
  });
}
const seen = new Set<string>();
const uniqueSources = sources.filter((source) => {
  if (seen.has(source.sourceUrl)) return false;
  seen.add(source.sourceUrl);
  return true;
});

const latitude = Number(destination.climate.latitude);
const longitude = Number(destination.climate.longitude);
const geo = Number.isFinite(latitude) && Number.isFinite(longitude)
  ? { "@type": "GeoCoordinates", latitude, longitude }
  : undefined;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      headline: `${destination.name} travel facts`,
      description: destination.dek,
      author: { "@type": "Organization", name: "TheTravelFact Editors" },
      publisher: { "@type": "Organization", name: "TheTravelFact", url: "https://thetravelfact.com" },
      datePublished: destination.climate.asOf,
      dateModified: destination.climate.asOf,
      mainEntityOfPage: canonical,
    },
    {
      "@type": "Place",
      name: destination.name,
      ...(geo ? { geo } : {}),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: crumbs.map((crumb, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: crumb.name,
        item: crumb.url,
      })),
    },
  ],
};
---

<Base title={`${destination.name} travel facts`} description={destination.dek} jsonLd={jsonLd}>
  <figure class="photo">
    <img src={photo.src} alt={photo.alt} width="1600" height="900" fetchpriority="high" />
    <figcaption>
      <span>{photo.alt}</span>
      <span>
        Photograph: {photo.artist}, <a href={photo.licenseUrl}>{photo.license}</a>, via <a href={photo.page}>Wikimedia Commons</a>
      </span>
    </figcaption>
  </figure>
  <article class="shell" data-pagefind-body data-pagefind-meta={`country:${destination.kind === "country" ? (destination.sheetLabel ?? "Country sheet") : destination.countryName}`}>
    <header>
      <nav class="crumbs" aria-label="Breadcrumb">
        {crumbs.map((crumb, index) => (
          <>
            {index > 0 && <span aria-hidden="true"> / </span>}
            {index === crumbs.length - 1 ? <span>{crumb.name}</span> : <a href={crumb.url.replace("https://thetravelfact.com", "")}>{crumb.name}</a>}
          </>
        ))}
      </nav>
      <div class="nameplate">
        <span class="no">{String(destination.order).padStart(2, "0")}</span>
        <div>
          <p class="kicker">{kicker}</p>
          <h1 data-pagefind-meta="title" data-pagefind-weight="10">{destination.name}</h1>
        </div>
      </div>
      <p class="dek">{destination.dek}</p>
      <p class="byline">TheTravelFact Editors · checked {checked}</p>
      <nav class="jumps" aria-label="On this sheet" data-pagefind-ignore>
        <ul>
          {jumps.map((j) => <li><a href={`#${j.id}`}>{j.label}</a></li>)}
        </ul>
      </nav>
    </header>
    <FactsCard destination={destination} />
    <div class="prose">
      {destination.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>
    <div id="weather"><ClimatePanel climate={destination.climate} /></div>
        {destination.season.length > 0 && (
          <section class="prose">
            <h2>Storm season, from the hurricane center</h2>
            {destination.season.map((line) => <p>{line}</p>)}
            <p class="note">Source: <a href="https://www.nhc.noaa.gov/climo/">National Hurricane Center climatology</a>. As of {checked}. This is the season window, not a forecast for a year.</p>
          </section>
        )}
        <section class="prose">
          <h2>The facts, in sentences</h2>
          {facts.map((fact) => (
            <>
              <h3 id={anchorFor[fact.label]}>{fact.label}</h3>
              <p>{fact.detail}</p>
              <p class="note">
                {factSources(fact).map((source, index) => (
                  <>
                    {index > 0 && " · "}
                    <a href={source.sourceUrl}>{source.sourceTitle}</a>
                  </>
                ))}
                . As of {longDate(fact.asOf ?? factSources(fact)[0]?.asOf ?? destination.climate.asOf)}.
              </p>
            </>
          ))}
          <h3 id="entry">Entry requirements</h3>
          <p>
            {destination.entry.note}{" "}
            <a href={destination.entry.url}>{destination.entry.publisher}: {destination.entry.label}</a>.
            Checked {entryChecked}. We do not rewrite the rule.
          </p>
        </section>
        {cities.length > 0 && (
          <section class="prose">
            <h2>The other stations</h2>
            <ul>
              {cities.map((city) => {
                const hot = extreme(city.climate.months, "high", "max");
                const wet = extreme(city.climate.months, "rain", "max");
                return (
                  <li>
                    <a href={city.path}>{city.name}</a>, {city.climate.stationName}:
                    {hot && <> highest average high {hot.value}°C in {joinMonths(hot.months)}</>}
                    {wet && <>; heaviest water-column month {joinMonths(wet.months)} at {wet.value} mm</>}.
                  </li>
                );
              })}
            </ul>
          </section>
        )}
    <div data-pagefind-ignore><Affiliates place={destination.name} plugValue={destination.plugs.value} /></div>
    <section class="prose" data-pagefind-ignore>
      <h2>Sources on this page</h2>
      <ul>
        {uniqueSources.map((source) => (
          <li><a href={source.sourceUrl}>{source.sourceTitle}</a>. As of {source.asOf}.</li>
        ))}
        <li><a href={destination.entry.url}>{destination.entry.publisher}</a>. As of {entryChecked}.</li>
        <li>
          Photograph: {photo.artist}, <a href={photo.licenseUrl}>{photo.license}</a>, <a href={photo.page}>Wikimedia Commons</a>.
        </li>
      </ul>
    </section>
  </article>
</Base>
