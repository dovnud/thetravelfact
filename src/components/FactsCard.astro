---
import type { Destination, Fact } from "../lib/types";
import { factSources } from "../lib/types";

interface Props {
  destination: Destination;
}
const { destination } = Astro.props;
const rows: Array<{ label: string; fact: Fact | null }> = [
  { label: "Plugs and voltage", fact: destination.plugs },
  { label: "Driving side", fact: destination.driving },
  { label: "Tipping", fact: destination.tipping },
  { label: "Tap water", fact: destination.water },
  { label: "Currency", fact: destination.currency },
  { label: "Time zone", fact: destination.timeZone },
  { label: "Travel advisory", fact: destination.advisory ?? null },
  { label: "Health and vaccines", fact: destination.health ?? null },
  { label: "Emergency numbers", fact: destination.emergency ?? null },
];
---

<table class="board">
  <caption>Figures</caption>
  <thead>
    <tr>
      <th scope="col">Field</th>
      <th scope="col">Figure</th>
      <th scope="col">Source</th>
    </tr>
  </thead>
  <tbody>
    {rows.map((row) => {
      const source = row.fact ? factSources(row.fact)[0] : undefined;
      return (
        <tr>
          <th scope="row">{row.label}</th>
          <td class="fig">{row.fact ? row.fact.value : "Not printed. No source we could cite."}</td>
          <td class="src">
            {source ? <a href={source.sourceUrl}>{source.sourceTitle}</a> : <a href="/sources/#gaps">Gaps</a>}
          </td>
        </tr>
      );
    })}
    <tr>
      <th scope="row">Entry</th>
      <td class="fig">Link only. No visa rule is restated.</td>
      <td class="src"><a href={destination.entry.url}>{destination.entry.publisher}</a></td>
    </tr>
  </tbody>
</table>
