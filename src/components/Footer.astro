---
const links = [
  ["/sources/", "Method"],
  ["/about/", "About"],
  ["/contact/", "Contact"],
  ["/affiliate-disclosure/", "Affiliate disclosure"],
  ["/privacy/", "Privacy"],
  ["/terms/", "Terms"],
];
---

<footer class="site-footer">
  <div class="shell foot">
    <div>
      <a class="mark" href="/">
        <span class="mark-block">TTF</span>
        <span class="mark-name">The Travel Fact</span>
      </a>
      <p class="credit">
        Contact <a href="mailto:contact@thetravelfact.com">contact@thetravelfact.com</a>.
        Type is Barlow and Barlow Condensed by Jeremy Tribby, and IBM Plex Mono by IBM, both under the SIL Open Font License.
        Photographs are Wikimedia Commons files; the credit sits on each sheet.
      </p>
    </div>
    <nav aria-label="Footer">
      {links.map(([href, label]) => <a href={href}>{label}</a>)}
    </nav>
  </div>
</footer>
