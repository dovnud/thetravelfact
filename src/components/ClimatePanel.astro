---
import type { Climate } from "../lib/types";
import { extreme, joinMonths } from "../lib/destinations";

interface Props {
  climate: Climate;
}
const { climate } = Astro.props;
const highs = climate.months.flatMap((m) => (m.high == null ? [] : [Number(m.high)]));
const lows = climate.months.flatMap((m) => (m.low == null ? [] : [Number(m.low)]));
const scaleMin = Math.min(...lows);
const scaleMax = Math.max(...highs);
const span = scaleMax - scaleMin || 1;
const rains = climate.months.map((m) => (m.rain == null ? 0 : Number(m.rain)));
const maxR = Math.max(...rains, 1);
const showPrecip = climate.months.some((m) => m.precip != null);
const hottest = extreme(climate.months, "high", "max");
const coldest = extreme(climate.months, "low", "min");
const wettest = extreme(climate.months, "rain", "max");
const driest = extreme(climate.months, "rain", "min");

function leftOf(value: number) {
  return ((value - scaleMin) / span) * 100;
}
---

<section class="almanac" aria-labelledby="climate-title">
  <h2 id="climate-title">Month by month</h2>
  <p>
    {hottest && <>The highest average daily high is {hottest.value}°C in {joinMonths(hottest.months)}. </>}
    {coldest && <>The lowest average daily low is {coldest.value}°C in {joinMonths(coldest.months)}. </>}
    {wettest && driest && (
      <>
        The {climate.columnRain.toLowerCase().startsWith("rain") ? "wettest" : "heaviest"} month in the water column is {joinMonths(wettest.months)} at {wettest.value} mm, and the lightest is {joinMonths(driest.months)} at {driest.value} mm.
      </>
    )}
    {" "}These sentences only restate the table. They are not a ranking of the best month to go.
  </p>
  <div class="table-wrap">
    <table class="board">
      <caption>
        {climate.caption}{" "}Averages for {climate.period}.{climate.elevation ? ` Elevation: ${climate.elevation}.` : ""}{" "}
        The rule runs from that month’s average low to its average high, on this station’s own scale. The black bar under the water figure is that month against the wettest month here.
      </caption>
      <thead>
        <tr>
          <th scope="col">Month</th>
          <th scope="col" class="num">High °C</th>
          <th scope="col" class="num">Low °C</th>
          <th scope="col">Low to high</th>
          <th scope="col" class="num">{climate.columnRain}</th>
          {showPrecip && <th scope="col" class="num">Precipitation (mm)</th>}
        </tr>
      </thead>
      <tbody>
        {climate.months.map((month) => {
          const high = month.high == null ? null : Number(month.high);
          const low = month.low == null ? null : Number(month.low);
          const rain = month.rain == null ? null : Number(month.rain);
          return (
            <tr>
              <th scope="row">{month.month}</th>
              <td class="num">{month.high ?? "—"}</td>
              <td class="num">{month.low ?? "—"}</td>
              <td>
                {high != null && low != null ? (
                  <span class="range" aria-hidden="true">
                    <i style={`left:${leftOf(low)}%;width:${Math.max(leftOf(high) - leftOf(low), 1)}%`}></i>
                    <b style={`left:calc(${leftOf(high)}% - 3px)`}></b>
                  </span>
                ) : (
                  "—"
                )}
              </td>
              <td class="num">
                {month.rain ?? "—"}
                {rain != null && <span class="rainbar" style={`width:${Math.max(8, (rain / maxR) * 100)}%`}></span>}
              </td>
              {showPrecip && <td class="num">{month.precip ?? "—"}</td>}
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>
  <p class="note">{climate.note} Source: <a href={climate.sourceUrl}>{climate.sourceTitle}</a>. As of {climate.asOf}.</p>
</section>
